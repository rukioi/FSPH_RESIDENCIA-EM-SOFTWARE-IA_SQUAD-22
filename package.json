{
  "name": "frota-svo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p backend/tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspaces",
    "test:e2e": "playwright test",
    "db:test:start": "tsx backend/src/database/scripts/start-test-db.ts",
    "db:test:prepare": "tsx backend/src/database/scripts/apply-test-migrations.ts",
    "db:docs:generate": "tsx backend/src/database/scripts/generate-db-docs.ts",
    "db:docs:check": "tsx backend/src/database/scripts/generate-db-docs.ts --check",
    "test:db": "vitest run backend/tests/database",
    "api:generate": "tsx scripts/generate-api.ts",
    "api:check": "tsx scripts/check-api.ts",
    "client:generate": "tsx scripts/generate-client.ts",
    "client:check": "tsx scripts/check-client.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "supabase": "2.122.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  }
}
